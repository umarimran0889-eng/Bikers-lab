# Shopify webhook secret, used to verify the X-Shopify-Hmac-Sha256 header on
# incoming orders/create webhooks. Found in your Shopify app / webhook config.
SHOPIFY_WEBHOOK_SECRET=

# Bearer token for Importations Thibault's Order API.
THIBAULT_API_TOKEN=

# Safety gate: real POST calls to Thibault's live Order API only happen when
# this is exactly "true". Leave unset/false while still verifying the
# pipeline - every Thibault-bound order is logged (what WOULD be sent) and
# answered with a simulated success response instead of a real network call.
# Only set to "true" once you're actually ready to test against their real
# system - see README "Thibault live calls are disabled by default".
THIBAULT_LIVE_CALLS_ENABLED=false

# Shopify Admin API - used to look up each line item's product tags, since
# Shopify's order webhook payload doesn't include per-line-item tags.
#
# This store uses Shopify's Dev Dashboard app system, which issues only
# short-lived access tokens (~24h) via an OAuth client_credentials grant -
# there is no static Admin API token to paste in. SHOPIFY_CLIENT_ID and
# SHOPIFY_CLIENT_SECRET below do NOT expire; the code (lib/shopifyAdminAuth.js)
# uses them to fetch and auto-refresh a short-lived access token as needed.
# The underlying token only needs the read_products scope - nothing else.
#
# Leave these blank to use the local mock (fixtures/product-tags.json)
# instead - see lib/productTags.js for the auto-detect logic.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_API_VERSION=2024-10

# Optional: force mock or live product tag lookups regardless of whether the
# above are set ("true" or "false"). Leave unset to auto-detect.
# SHOPIFY_ADMIN_MOCK=true

# Optional: when "true", every order sent to Thibault is flagged test_mode:true
# so it doesn't create a real order on their system. Strongly recommended
# while testing locally.
THIBAULT_TEST_MODE=true

# Resend (https://resend.com) - sends failure-alert emails for: Thibault
# API rejections, unresolved product tag lookups, Shopify Admin auth
# failures, and unexpected webhook handler errors. Create a free account
# and API key yourself.
RESEND_API_KEY=

# Address alerts are sent to. Leave blank to disable alert sending entirely
# (sendFailureAlert() logs a warning and skips instead of crashing) - useful
# before a final recipient is decided. The address used locally may not be
# the final production one.
ALERT_EMAIL_TO=

# "From" address Resend sends as. Defaults to onboarding@resend.dev
# (Resend's shared test/sandbox address) if unset - a real from-address
# (e.g. alerts@bikerlab.com) requires verifying a domain in Resend first.
# ALERT_EMAIL_FROM=alerts@yourdomain.com

# Port for the local dev server (scripts/dev-server.js).
PORT=3000
